RewriteEngine On
RewriteBase /

# Existing files (built SPA, uploads, assets)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# PHP API (same paths the React app already calls: /api/...)
RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

# SPA fallback
RewriteRule ^ index.html [L]
